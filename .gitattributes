# Force LF line endings for shell scripts and patches
.gitattributes text eol=lf
.gitignore text eol=lf
*.sh text eol=lf
scripts/*.sh text eol=lf
scripts/**/*.sh text eol=lf
.github/workflows/*.yml text eol=lf
*.md text eol=lf
*.py text eol=lf
*.patch text eol=lf

# Unified diffs need " " (a single space) for a blank context line, so a patch
# file legitimately contains trailing whitespace. Exempt them from diff --check.
*.patch whitespace=-blank-at-eol

# Keep Windows line endings for Windows-specific files
*.bat text eol=crlf
*.ps1 text eol=crlf
